# Порты Docker Compose на хосте.
DEMO_API_PORT=8000
DEMO_PROMETHEUS_PORT=9090
DEMO_GRAFANA_PORT=3000

# Лимит создания заданий на IP.
SYNC_JOB_RATE_LIMIT=5
SYNC_JOB_RATE_WINDOW_SECONDS=60

# Общий тестовый токен для демо-поставщика, backend и воркера.
SUPPLIER_TOKEN=local-demo

# Путь к базе при запуске без Docker.
DATABASE_PATH=data/catalog.sqlite3
